{% sw_extends '@Storefront/storefront/page/checkout/_page.html.twig' %}

{% block base_content %}
    {% if page.EcobrotboxB2B.blockCheckout is not defined or page.EcobrotboxB2B.blockCheckout is false %}
        {{ parent() }}
    {% else %}
        {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
            type:"primary",
            content: ("ecobrotbox.b2b.checkout.blocked"|trans)
        } %}
    {% endif %}
{% endblock %}